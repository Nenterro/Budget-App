{
  "version": 1,
  "_comment": [
    "Askari Bank (AKBL), written against real messages.",
    "",
    "Loads after 10-wallets.json and before 20-banks.json, so these claim an",
    "Askari message before the broad sender-recognition rule does.",
    "",
    "The recurring difficulty in this bank's wording is that an incoming",
    "transfer names two parties: the sender, and the account holder receiving",
    "it. A naive 'received from (.+)' swallows both. Each pattern below stops",
    "the merchant at whichever comes first - the counterparty's account marker",
    "('AKBL A C *0462') or the ' in ' that introduces the recipient."
  ],
  "templates": [
    {
      "id": "askari-transfer-credit",
      "bank": "Askari Bank",
      "senders": ["Askari", "AKBL"],
      "match": "(?:IBFT\\s+of\\s+)?(?P<currency>PKR)\\.?\\s*(?P<amount>[\\d,]+(?:\\.\\d{1,2})?)\\s+received\\s+from\\s+(?P<merchant>.+?)\\s+(?:(?:AKBL\\s+)?A\\s*/?\\s*C\\s*#?\\s*\\*|\\bin\\b)(?:.*?\\bAKBL\\b[^*]{0,20}\\*(?P<last4>\\d{4}))?(?:.*?\\bon\\s+(?P<date>\\d{2}\\s+\\d{2}\\s+\\d{2}))?",
      "direction": "credit",
      "confidence": 0.95
    },
    {
      "id": "askari-pos-debit",
      "bank": "Askari Bank",
      "senders": ["Askari", "AKBL"],
      "match": "POS\\s+transaction\\s+of\\s+(?P<currency>PKR)\\.?\\s*(?P<amount>[\\d,]+(?:\\.\\d{1,2})?)\\s+from\\s+Account:?\\s*[\\d*]+\\s+on\\s+(?P<merchant>[A-Za-z0-9 .&'/-]+?)\\s*,\\s*at\\b.*?Dated:?\\s*(?P<date>\\d{1,2}-[A-Za-z]{3}-\\d{2,4})",
      "direction": "debit",
      "confidence": 0.95
    },
    {
      "id": "askari-dividend-credit",
      "bank": "Askari Bank",
      "senders": ["Askari", "AKBL"],
      "match": "AMOUNTING\\s+TO\\s+(?P<currency>PKR)\\.?\\s*(?P<amount>[\\d,]+(?:\\.\\d{1,2})?).*?AGAINST\\s+SHARES\\s+OF\\s+(?P<merchant>[A-Za-z0-9&. -]+?)\\s+HAS\\s+BEEN\\s+CREDITED",
      "direction": "credit",
      "confidence": 0.95
    }
  ]
}
