# Copy to .env and fill in. Never commit the filled-in file.

# PocketBase, reachable on the compose network by container name.
PB_URL=http://pocketbase:8090

# PocketBase admin login (the one you use at /_/).
# Needed to create the inbox collection and to file drafts for your user.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# The budget app account the drafts belong to - the email you log into the
# budget app with, not the admin one (they may be the same).
BUDGET_USER_EMAIL=

# Shared secret the iPhone Shortcut sends. Generate with:
#   openssl rand -hex 32
INGEST_TOKEN=

# Optional
INBOX_COLLECTION=inbox_messages
INBOX_RETENTION_DAYS=30
DEDUPE_WINDOW_HOURS=24
